rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "yadavritesh528@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReview(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1500 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('role' in data) || (data.role is string && data.role.size() <= 100)) &&
             (!('institution' in data) || (data.institution is string && data.institution.size() <= 150)) &&
             (!('verified' in data) || data.verified is bool) &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500));
    }

    function isValidProduct(data) {
      return data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.currency is string && data.currency.size() > 0 && data.currency.size() <= 10 &&
             data.displayPrice is string && data.displayPrice.size() > 0 && data.displayPrice.size() <= 20 &&
             data.gumroadCheckoutUrl is string && data.gumroadCheckoutUrl.size() > 0 && data.gumroadCheckoutUrl.size() <= 1000 &&
             data.isActive is bool;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      // Public can only list/get approved reviews. Admins can read all reviews.
      allow read: if (resource != null && resource.data.status == 'approved') || isAdmin();

      // Any visitor can submit a review, but it must be pending and have no privileged flags
      allow create: if isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       incoming().status == 'pending' &&
                       (!('verified' in incoming()) || incoming().verified == false) &&
                       (!('adminNote' in incoming()) || incoming().adminNote == '');

      // Only admins can update (approve, reject, add adminNote, verify)
      allow update: if isValidId(reviewId) &&
                       isAdmin() &&
                       isValidReview(incoming());

      // Only admins can delete
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // Products / Dynamic Pricing Collection
    match /products/{productId} {
      // Public can read product pricing
      allow read: if true;

      // Only admins can create or update pricing
      allow create, update: if isValidId(productId) &&
                               isAdmin() &&
                               isValidProduct(incoming());

      allow delete: if isValidId(productId) && isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }
  }
}
